# PostgreSQL
POSTGRES_DB=whatcook
POSTGRES_USER=whatcook
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://whatcook:replace_with_a_long_random_password@localhost:5432/whatcook?sslmode=disable

# Backend
PORT=8080
BACKEND_PORT=8080
GIN_MODE=release
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CORS_ALLOWED_ORIGINS=https://whatcook.example.com
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Sber GigaChat API
GIGACHAT_AUTH_KEY=replace_with_gigachat_auth_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=https://api.whatcook.example.com

# Recipe Worker
RECIPE_WORKER_ENABLED=true
RECIPE_WORKER_TARGET_TOTAL=500
RECIPE_WORKER_CHUNK_SIZE=50
RECIPE_WORKER_SUB_BATCH_SIZE=3
RECIPE_WORKER_SUB_BATCH_PAUSE=1m
RECIPE_WORKER_RATE_LIMIT_PAUSE=10m
