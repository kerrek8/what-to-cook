# PostgreSQL
POSTGRES_DB=whatcook
POSTGRES_USER=whatcook
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
GIN_MODE=release
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CORS_ALLOWED_ORIGINS=https://whatcook.example.com

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=https://api.whatcook.example.com
VITE_LIBRETRANSLATE_URL=https://translate.whatcook.example.com
LIBRETRANSLATE_PORT=5000
