{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "WhatCook Design Tokens (Emerald Gastro)",
  "version": "1.0.0",
  "platform": "Android Mobile PWA",
  "color": {
    "brand": {
      "primary": { "value": "#064E3B", "type": "color", "description": "Глубокий изумрудный, основной фирменный цвет" },
      "primary-light": { "value": "#047857", "type": "color", "description": "Светлый изумруд для hover/active" },
      "primary-dark": { "value": "#022C22", "type": "color", "description": "Темный изумруд для шапок и карточек" },
      "accent": { "value": "#10B981", "type": "color", "description": "Яркая мята для акцентных кнопок, бейджей и прогресса" },
      "accent-subtle": { "value": "#ECFDF5", "type": "color", "description": "Мягкий мятный фон для чипов и выделений" }
    },
    "canvas": {
      "bg": { "value": "#F8FAFC", "type": "color", "description": "Основной фон экранов приложения" },
      "card": { "value": "#FFFFFF", "type": "color", "description": "Фон белых карточек и модальных шторок" },
      "subtle": { "value": "#F1F5F9", "type": "color", "description": "Второстепенный фон для контейнеров и инпутов" },
      "border": { "value": "#E2E8F0", "type": "color", "description": "Разделители и границы карточек" },
      "border-light": { "value": "#F1F5F9", "type": "color", "description": "Тонкие внутренние линии" }
    },
    "kitchen-dark": {
      "bg": { "value": "#061811", "type": "color", "description": "Глубокий темный фон режима готовки Cook Mode" },
      "surface": { "value": "#0B261D", "type": "color", "description": "Фон карточек шагов и таймера в Cook Mode" },
      "border": { "value": "#133E30", "type": "color", "description": "Контуры карточек в темном режиме" },
      "text-high": { "value": "#FFFFFF", "type": "color", "description": "Контрастный белый текст в Cook Mode" },
      "text-muted": { "value": "#94A3B8", "type": "color", "description": "Второстепенный текст в Cook Mode" }
    },
    "semantic": {
      "fresh": { "value": "#059669", "type": "color", "description": "Свежий продукт (> 3 дней)" },
      "fresh-bg": { "value": "#ECFDF5", "type": "color", "description": "Фон бейджа свежести" },
      "expiring": { "value": "#D97706", "type": "color", "description": "Истекающий продукт (1–3 дня)" },
      "expiring-bg": { "value": "#FFFBEB", "type": "color", "description": "Фон бейджа истекающего продукта" },
      "expired": { "value": "#DC2626", "type": "color", "description": "Просроченный продукт (< 0 дней)" },
      "expired-bg": { "value": "#FEF2F2", "type": "color", "description": "Фон бейджа просроченного продукта" },
      "info": { "value": "#2563EB", "type": "color", "description": "Информационный статус и офлайн-бейдж" },
      "info-bg": { "value": "#EFF6FF", "type": "color", "description": "Фон информационного бейджа" }
    },
    "text": {
      "primary": { "value": "#0F172A", "type": "color", "description": "Основной темный текст (slate-900)" },
      "secondary": { "value": "#475569", "type": "color", "description": "Второстепенный текст с высоким контрастом (slate-600)" },
      "muted": { "value": "#64748B", "type": "color", "description": "Текст подписей и плейсхолдеров (slate-500)" },
      "on-primary": { "value": "#FFFFFF", "type": "color", "description": "Белый текст на изумрудных кнопках" }
    }
  },
  "spacing": {
    "touch-target-min": { "value": "48px", "type": "dimension", "description": "Минимальный размер кликабельной зоны Material Guidelines" },
    "touch-target-compact": { "value": "44px", "type": "dimension", "description": "Компактная тач-зона для вспомогательных иконок" },
    "tabbar-height": { "value": "64px", "type": "dimension", "description": "Базовая высота навигационной панели таб-бара" },
    "content-bottom-clearance": { "value": "112px", "type": "dimension", "description": "Безопасный нижний отступ контента (pb-28) под таб-бар и навигацию Android" }
  },
  "radius": {
    "sm": { "value": "10px", "type": "dimension" },
    "md": { "value": "14px", "type": "dimension" },
    "lg": { "value": "18px", "type": "dimension" },
    "xl": { "value": "24px", "type": "dimension" },
    "full": { "value": "9999px", "type": "dimension" }
  },
  "shadow": {
    "subtle": { "value": "0 2px 8px -2px rgba(15, 23, 42, 0.05)", "type": "shadow" },
    "soft": { "value": "0 4px 20px -2px rgba(15, 23, 42, 0.06)", "type": "shadow" },
    "elevated": { "value": "0 10px 30px -4px rgba(15, 23, 42, 0.10)", "type": "shadow" },
    "glow-accent": { "value": "0 0 20px rgba(16, 185, 129, 0.35)", "type": "shadow" }
  },
  "typography": {
    "font-family-sans": { "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif", "type": "fontFamily" },
    "scale": {
      "display": { "fontSize": "26px", "lineHeight": "32px", "fontWeight": "700" },
      "title-lg": { "fontSize": "20px", "lineHeight": "26px", "fontWeight": "600" },
      "title-md": { "fontSize": "17px", "lineHeight": "22px", "fontWeight": "600" },
      "body-base": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": "400" },
      "body-sm": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": "400" },
      "caption": { "fontSize": "11px", "lineHeight": "14px", "fontWeight": "500" }
    }
  },
  "haptics": {
    "light": { "value": "10ms", "description": "Тап по чипам, чекбоксам и вкладкам таб-бара" },
    "medium": { "value": "25ms", "description": "Успешное добавление/списание продукта, переключение шага готовки" },
    "warning": { "value": "40ms", "description": "Удаление продукта, срабатывание таймера готовки" }
  }
}
